# ---- ROMs (never commit, any byte order or extension) ----
*.z64
*.n64
*.v64
*.rom
*.ndd
baserom*

# ---- Recompiler output (regenerated from the ROM) ----
RecompiledFuncs/
RecompiledPatches/
rsp/*.cpp

# ---- Recompiler and tool binaries ----
N64Recomp
N64Recomp.exe
RSPRecomp
RSPRecomp.exe
N64RecompSource/
*.exe
*.dll
*.pdb

# ---- Build output ----
build/
build-*/
out/
*.o
*.obj
*.elf
*.map
*.bin
*.d

# ---- splat project: keep configs and symbol files, ignore generated output ----
disasm/.venv/
disasm/asm/
disasm/assets/
disasm/build/
disasm/include/
disasm/*.ld
disasm/undefined_funcs_auto.txt
disasm/undefined_syms_auto.txt
disasm/.splat_cache*

# ---- Python ----
__pycache__/
*.pyc
.venv/
venv/

# ---- Local logs and screenshots from testing ----
*.log
shot-*.png

# ---- Editors and OS ----
.vs/
.vscode/
.idea/
*.user
*.swp
.DS_Store
Thumbs.db

# ---- Claude Code local settings (keep project CLAUDE.md tracked) ----
.claude/settings.local.json

# ---- Private notes about the owner, read by CLAUDE.md, never committed ----
*.local.md
